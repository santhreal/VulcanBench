  "decontamination_notes": "Real bug fix from santhsecurity/vyre commit 0685fea4 (2026-06-23), after model training cutoffs. The collect_vars_in_expr function in vyre-foundation's loop_fusion pass collected index and value from Expr::Atomic but not the expected operand of a compare-exchange, letting a cross-loop scalar read go undetected. Self-contained micro crate distilled from that analysis for offline grading. LICENSE-MIT and LICENSE-APACHE preserved from upstream. Coverage floor: 3 fail_to_pass tests (CAS expected creates dependency; expected distinct from value; nested expected expression).",
  "grader": "tests",
  "tests": {
    "fail_to_pass": [
      {
        "name": "cas_expected_creates_dep",
        "cmd": "cargo test --offline --test vb_loop_fusion_cas cas_expected_creates_scalar_dependency"
      },
      {
        "name": "cas_expected_separate_from_value",
        "cmd": "cargo test --offline --test vb_loop_fusion_cas cas_expected_is_separate_from_value_operand"
      },
      {
        "name": "cas_expected_nested_expr_creates_dep",
        "cmd": "cargo test --offline --test vb_loop_fusion_cas cas_expected_nested_expr_creates_dep"
      }
    ],
